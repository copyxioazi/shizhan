# Copy to .env and fill in. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GENERATOR_MODEL=deepseek-chat
JUDGE_MODEL=deepseek-reasoner

# Guardrail for synthetic data generation (approximate, based on token usage).
DATA_BUDGET_USD=30
PRICE_INPUT_PER_M=0.27
PRICE_OUTPUT_PER_M=1.10

# Local caches (Windows example)
# HF_HOME=D:\huggingface_cache

# Cloud (ModelScope) caches
# HF_HOME=/mnt/data/hf
# MODELSCOPE_CACHE=/mnt/data/ms
# TMPDIR=/mnt/data/tmp
