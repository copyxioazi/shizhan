{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KBSFT sample",
  "type": "object",
  "required": ["id", "task_type", "messages", "contexts", "expected_behavior", "metadata"],
  "properties": {
    "id": {"type": "string"},
    "task_type": {"enum": ["faithful", "refusal", "multi", "term"]},
    "subtype": {"type": "string"},
    "messages": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["system", "user", "assistant"]},
          "content": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chunk_id", "doc_id", "file_title", "content"],
        "properties": {
          "idx": {"type": "integer"},
          "chunk_id": {"type": "string"},
          "doc_id": {"type": "string"},
          "source": {"type": "string"},
          "file_title": {"type": "string"},
          "title": {"type": "string"},
          "display_title": {"type": "string"},
          "url": {"type": "string"},
          "content": {"type": "string"},
          "score": {"type": "number"},
          "rank": {"type": "integer"},
          "injected": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "evidence": {"type": "array"},
    "claims": {"type": "array"},
    "citations": {"type": "array"},
    "expected_behavior": {"enum": ["answer", "refuse", "partial", "conflict"]},
    "metadata": {"type": "object"},
    "gold": {"type": "boolean"}
  },
  "additionalProperties": true
}
