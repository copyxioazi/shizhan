# ============================================================
# 自动化安全评估系统 - 环境变量样例
# 复制为仓库根目录 .env 后按实际环境修改；.env 不入库。
# ============================================================

# ---------- PostgreSQL（Linux VM 上的 Docker Compose） ----------
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=sec_eval

# VM 上 PostgreSQL 端口绑定的地址（host-only / 内网地址；不要暴露到公网）
DB_BIND_ADDR=192.168.56.10

# ---------- 认证 ----------
# 必填，长度 >= 32，缺失时后端拒绝启动
JWT_SECRET=please-change-this-to-a-random-string-with-at-least-32-chars
JWT_EXPIRE_HOURS=24

# ---------- Docker over SSH（Linux VM） ----------
# 后端通过 SSH 连接 VM 的 Docker Engine；Windows 本机不需要 Docker Desktop
DOCKER_HOST=ssh://eval@192.168.56.10
DOCKER_SSH_KEY=C:/Users/yourname/.ssh/ase_eval_key
# VM 工作区根目录（源码副本与容器可写工作区）
VM_WORKSPACE_DIR=/home/eval/workspace

# ---------- 应用 ----------
APP_HOST=127.0.0.1
APP_PORT=8000
# 前端 Vite 代理目标，必须与 APP_PORT 指向同一个后端
ASE_API_TARGET=http://127.0.0.1:8000
# 逗号分隔
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LOG_LEVEL=INFO

# 本机运行时目录（相对仓库根目录或绝对路径）
RUNTIME_LOGS_DIR=runtime_logs
REPORTS_DIR=reports
