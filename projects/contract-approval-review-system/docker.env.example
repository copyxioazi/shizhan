# Docker 部署配置模板
# 用法一：复制为 .env（docker compose 默认读取）
#   cp docker.env.example .env
# 用法二：另存为 docker.env，然后
#   docker compose --env-file docker.env up -d

# 宿主机端口
APP_PORT=8000

# ===== 数据库地址 =====
# SQLite 数据目录（宿主机路径），容器内挂载为 /app/data
DATA_DIR=./data

# 容器内数据库文件路径（一般保持默认即可）
LOCAL_DB_PATH=/app/data/app.db
MOCK_DB_PATH=/app/data/mock_upstream.db

# 如果希望数据库放在别的宿主机目录，例如 /srv/contract-review：
# DATA_DIR=/srv/contract-review
#
# 如果额外挂载了其他容器目录（见 docker-compose.yml 的 volumes 注释）：
# LOCAL_DB_PATH=/app/db/app.db
# MOCK_DB_PATH=/app/db/mock_upstream.db

# 当前版本使用 SQLite，以下连接串仅作后续迁移 PostgreSQL/MySQL 的占位，
# 当前代码不会读取。
# DATABASE_URL=postgresql://user:password@db-host:5432/contract_review

# ===== 异步队列 =====
QUEUE_MAXSIZE=100
WORKER_CONCURRENCY=2

# ===== 解析 =====
OCR_TEXT_MIN_CHARS=40

# ===== LLM（可选，默认关闭） =====
LLM_ENABLED=false
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=15
