# 服务
UPSTREAM_BASE_URL=http://127.0.0.1:8000
LOCAL_DB_PATH=data/app.db
MOCK_DB_PATH=data/mock_upstream.db

# 异步队列
QUEUE_MAXSIZE=100
WORKER_CONCURRENCY=2
SHUTDOWN_GRACE_SECONDS=10

# 解析
OCR_TEXT_MIN_CHARS=40

# LLM 可选润色（默认关闭；请勿在样例文件中填写真实密钥）
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=15
